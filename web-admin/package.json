    "@tailwindcss/vite": "^4.1.12",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.21",
    "jsdom": "^27.2.0",
    "sass-embedded": "^1.90.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
