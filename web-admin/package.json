{
  "name": "com-powerx-plugin-ecommerce-web-admin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/nuxi/bin/nuxi.mjs dev",
    "build": "node ./node_modules/nuxi/bin/nuxi.mjs build",
    "lint": "node -e \"console.log('Lint checks pending configuration');\" --",
