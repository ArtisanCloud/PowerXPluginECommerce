    "@nuxt/eslint": "^1.9.0",
    "@nuxt/icon": "^2.0.0",
    "@nuxt/image": "^1.11.0",
    "@nuxt/scripts": "^0.11.10",
    "@nuxt/test-utils": "^3.19.2",
    "@nuxt/ui": "^3.3.2",
    "@nuxtjs/color-mode": "^3.5.2",
    "@nuxtjs/i18n": "^10.1.0",
    "@pinia/nuxt": "^0.11.2",
    "@unhead/vue": "^2.0.14",
    "better-sqlite3": "^12.2.0",
    "echarts": "^5.6.0",
    "eslint": "^9.33.0",
    "nuxi": "^3.29.3",
    "nuxt": "^4.2.0",
    "sass": "^1.91.0",
    "tailwindcss": "^4.1.15",
    "vue": "^3.5.18",
