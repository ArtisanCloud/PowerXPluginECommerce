    "test:ci": "npm run test:unit",
    "test:unit": "node ./node_modules/vitest/dist/cli.js run --dir tests/unit && node ./node_modules/vitest/dist/cli.js run --dir tests/component",
    "test:e2e": "playwright test tests/e2e/product-sku.spec.ts"
  },
