.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  background: #ffffff;
  border-top: 1px solid rgba(0, 0, 0, 0.08);
}

.tabbar__inner {
  height: 64px;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 8px 12px 0;
}

.tabbar__side {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.tabbar__item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1px;
}

.tabbar__item--active .tabbar__text {
  font-weight: 900;
}

.tabbar__indicator {
  position: static;
  margin-top: 4px;
  width: 18px;
  height: 3px;
  background: #4f8a7e;
  border-radius: 9999px;
}

.tabbar__fabWrap {
  width: 84px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tabbar__fab {
  width: 56px;
  height: 56px;
  border-radius: 9999px;
  background: #4f8a7e;
  border: 4px solid #ffffff;
  box-shadow: 0 10px 24px rgba(79, 138, 126, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translateY(-18px);
}

.tabbar__fabPlus {
  font-size: 30px;
  font-weight: 900;
  color: #ffffff;
  line-height: 1;
  position: relative;
  top: -1px;
}

.tabbar__icon {
  width: 24px;
  height: 24px;
  display: block;
}

.tabbar__text {
  font-size: 10px;
  line-height: 1;
  font-weight: 600;
}

.tabbar__safe {
  height: env(safe-area-inset-bottom);
  height: constant(safe-area-inset-bottom);
}
