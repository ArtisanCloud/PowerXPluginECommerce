{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": ["create"]
    },
    "template": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "content": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["title", "description", "content"],
      "additionalProperties": true
    }
  },
  "required": ["action", "template"],
  "additionalProperties": true
}
